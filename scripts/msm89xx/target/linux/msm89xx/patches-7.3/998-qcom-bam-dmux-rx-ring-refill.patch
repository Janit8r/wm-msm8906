-	if (bam_dmux_skb_dma_queue_rx(skb_dma, GFP_ATOMIC))
+	if (bam_dmux_skb_dma_queue_rx(skb_dma, GFP_ATOMIC)) {
+		dma_async_issue_pending(dmux->rx);
+	} else {
+		/*
+		 * GFP_ATOMIC 下分配 skb / DMA 映射 / 准备描述符失败时，原代码直接
+		 * 什么也不做：这个 slot 既没有挂着的描述符，也不会被重新排队，等于
+		 * 永久丢失。RX 环一共只有 BAM_DMUX_NUM_SKB 个 slot，丢一个少一个，
+		 * 下行速率会被慢慢掐死，而且内核日志里一点痕迹都没有。
+		 * 这里把它标记为掉线，交给工作队列用 GFP_KERNEL 重试。
+		 */
+		skb_dma->rx_queued = false;
+		schedule_work(&dmux->rx_refill_work);
+	}
+}
+
+static void bam_dmux_rx_refill_work(struct work_struct *work)
+{
+	struct bam_dmux *dmux = container_of(work, struct bam_dmux, rx_refill_work);
+	bool issued = false;
+	int i;
+
+	/* 断电之后不要再往已释放的 DMA 通道上挂描述符 */
+	if (!dmux->rx)
+		return;
+
+	for (i = 0; i < BAM_DMUX_NUM_SKB; i++) {
+		struct bam_dmux_skb_dma *skb_dma = &dmux->rx_skbs[i];
+
+		if (skb_dma->rx_queued)
+			continue;
+		if (!bam_dmux_skb_dma_queue_rx(skb_dma, GFP_KERNEL))
+			continue;
+		issued = true;
+	}
+
+	if (issued)
 		dma_async_issue_pending(dmux->rx);
 }
 
