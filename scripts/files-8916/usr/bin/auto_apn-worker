#!/bin/sh
#
# auto_apn-worker —— 由 /etc/init.d/auto_apn 通过 procd 托管运行
#
# 职责：等待 modem 出现 -> 启用 -> 按 IMSI 自动配置 APN -> 保证数据通道有 IP -> 常驻看护
#
# 为什么要单独一个脚本 + procd：
#   rc.common 的 start() 是同步执行的，S99 阶段在这里长时间阻塞会拖住开机；
#   而在 start() 里用 `worker &` 起的后台子进程，在 init 脚本退出后有被回收的风险
#   （实测从 adb shell 启动时子进程会被一起杀掉，ps 里查不到）。
#   交给 procd 托管最稳，进程意外退出还会被自动拉起。
#
# 背景：
#   1) 本机 modem 由 remoteproc(qcom-q6v5-mss) 拉起，实测上电后十几秒到几分钟才出现。
#      早期实现只等 60s，等不到就退出，mmcli --enable 永远不执行，
#      modem 一直停在 disabled，导致 simadmin 的 /api/cells 报：
#        org.freedesktop.ModemManager1.Error.Core.WrongState:
#        Wrong state: modem in disabled state
#   2) ModemManager 1.24 的这个构建里既没有 --no-auto-enable，实测也不会自动启用，
#      必须显式 mmcli --enable。
#   3) MM 重启 / modem 复位 / remoteproc rebind / qmi-modem-410-init 重新下发 QMI
#      profile 之后，modem 会重新变回 disabled，所以要常驻看护。
#   4) 实测 mmcli --enable 有两种失败形态，必须分别处理：
#        - power state 为 off 时报 "Invalid transition" -> 先 --set-power-state-on 再 enable
#        - 状态是 enabled 但长时间 detached（无注册）-> 说明注册流程挂了，做一次 --reset
#   5) 光把 modem 启用还不够。simadmin 的 uci-defaults 把 netifd 的 network.modem
#      接口设成 disabled=1，而 openstick_tweak 只补了 autoconnect/auto 没清 disabled，
#      于是 netifd 永远不启用这个接口。结果是：modem 能 registered/attached，
#      但 MM 里没有 default bearer，wwan0 拿不到 IPv4、没有默认路由
#      —— 表现为「注册成功但不能上网」。
#      所以还要保证 network.modem 接口是启用的，由 netifd 的 modemmanager proto
#      负责建 bearer、写 IP/默认路由/DNS。
#      （配套的 /etc/uci-defaults/zz-modem-data 负责开机时就把它改对）
#   6) 有 IPv4 也不等于真能上网：bearer 僵死、上游掉线、APN 变更都会出现
#      「有 IP 但 ping 不通」。所以还要做真实连通性探测（ensure_online），
#      连续 3 轮（约 90s）不通就重拨一次 network.modem。
#
# 解析注意：
#   不要用 `grep -o 'state: *[a-z-]*'` 这种写法。busybox 的 grep -o / sed 在
#   结尾带 `*` 的子表达式上会做**最短匹配**，实测对 `state: connected` 只匹配出
#   `state: `（空值），于是把 connected 误判成 disabled，worker 每 30 秒空跑一次
#   mmcli --enable。统一改用 mmcli 的 -K（key-value）输出 + 精确前缀替换。

PIDFILE=/var/run/auto_apn.pid
DONEFILE=/var/run/auto_apn.apn_done
STUCKF=/var/run/auto_apn.stuck
NOIPF=/var/run/auto_apn.noip
OFFLINEF=/var/run/auto_apn.offline
SECTION="modem"

# 连通性探测目标：两个不同运营商的公共 DNS，任一可达就算在线
PING_TARGETS="223.5.5.5 114.114.114.114"

# 等待 modem：300 x 2s = 600s，覆盖启动耗时并留足余量
WAIT_TRIES=300
WAIT_INTERVAL=2
# 看护间隔
WATCH_INTERVAL=30
# 连续多少轮 "enabled 但未注册" 后做一次 reset（8 x 30s = 240s）
STUCK_LIMIT=8

log() {
	logger -t auto-apn "$1"
}

# mmcli -L -K -> "modem-list.value[1] : /org/.../Modem/0" -> "0"
modem_index() {
	mmcli -L -K 2>/dev/null | sed -n 's#^modem-list\.value\[1\] *: .*/Modem/##p' | head -1
}

# "modem.generic.state : connected" -> "connected"
modem_state() {
	mmcli -m "$1" -K 2>/dev/null | sed -n 's/^modem\.generic\.state *: *//p' | head -1
}

# "modem.3gpp.packet-service-state : attached" -> "attached"
modem_attached() {
	mmcli -m "$1" -K 2>/dev/null | sed -n 's/^modem\.3gpp\.packet-service-state *: *//p' | head -1
}

wait_modem() {
	_i=0
	while [ "$_i" -lt "$WAIT_TRIES" ]; do
		_m=$(modem_index)
		if [ -n "$_m" ]; then
			echo "$_m"
			return 0
		fi
		_i=$((_i + 1))
		sleep "$WAIT_INTERVAL"
	done
	return 1
}

# 卡在 enabled 但一直没注册时，计数并适时 reset
check_stuck() {
	_m="$1"
	_s="$2"

	# 只要不是 enabled 就把计数清零（registered / searching / enabling 都算正常过程）
	if [ "$_s" != "enabled" ]; then
		rm -f "$STUCKF"
		return 0
	fi

	# enabled 且已 attach 属于正常
	[ "$(modem_attached "$_m")" = "attached" ] && { rm -f "$STUCKF"; return 0; }

	_n=0
	[ -f "$STUCKF" ] && _n=$(cat "$STUCKF" 2>/dev/null)
	case "$_n" in ''|*[!0-9]*) _n=0 ;; esac
	_n=$((_n + 1))
	echo "$_n" > "$STUCKF"

	if [ "$_n" -ge "$STUCK_LIMIT" ]; then
		log "modem $_m stuck in 'enabled' without registration for $((_n * WATCH_INTERVAL))s, resetting"
		log "  $(mmcli -m "$_m" --reset 2>&1)"
		echo 0 > "$STUCKF"
	fi
	return 0
}

ensure_enabled() {
	[ -z "$1" ] && return 1
	_m="$1"
	_s=$(modem_state "$_m")

	# 读不到状态说明 mmcli 这一轮没成功，别乱动，下一轮再看
	if [ -z "$_s" ]; then
		log "modem $_m: cannot read state this round, skip"
		return 0
	fi

	if [ "$_s" != "disabled" ]; then
		check_stuck "$_m" "$_s"
		return 0
	fi

	log "modem $_m is disabled, enabling"
	_out=$(mmcli -m "$_m" --enable 2>&1)
	log "  $_out"

	case "$_out" in
		*"Invalid transition"*|*WrongState*)
			# power state 为 off 时 MM 会拒绝 enable，先上电再启用
			log "  enable rejected, trying power-state-on first"
			log "  $(mmcli -m "$_m" --set-power-state-on 2>&1)"
			sleep 3
			log "  $(mmcli -m "$_m" --enable 2>&1)"
			;;
	esac

	# 给 MM 一点时间完成启用流程
	_j=0
	while [ "$_j" -lt 15 ]; do
		_s=$(modem_state "$_m")
		[ -n "$_s" ] && [ "$_s" != "disabled" ] && break
		_j=$((_j + 1))
		sleep 2
	done
	log "modem $_m state now: ${_s:-unknown}"
	return 0
}

# 数据通道看护：modem 已经 attached 但 wwan0 上没有 IPv4 时，把 netifd 的
# network.modem 接口拉起来，由 modemmanager proto 负责建 bearer、写 IP 和默认路由。
# 少了这一步就会出现「注册成功、attached，但没 IP、不能上网」。
ensure_data() {
	_m="$1"

	# 段必须存在且类型是 interface。段缺失时 uci set network.modem.apn=xxx
	# 会建出 `config modem 'modem'`，netifd 不认，ifup 永远失败 —— 这里兜底重建。
	if [ "$(uci -q get "network.$SECTION")" != "interface" ]; then
		log "network.$SECTION missing or not an interface, recreating"
		uci -q delete "network.$SECTION" 2>/dev/null
		uci -q set "network.$SECTION=interface"
		uci -q set "network.$SECTION.proto='modemmanager'"
		uci -q set "network.$SECTION.device='0'"
		uci -q set "network.$SECTION.iptype='ipv4'"
		uci -q set "network.$SECTION.metric='10'"
		uci -q set "network.$SECTION.peerdns='1'"
		uci -q set "network.$SECTION.disabled='0'"
		uci -q set "network.$SECTION.autoconnect='1'"
		uci -q commit network
	fi

	# modem 崩溃后 remoteproc 会重新加载，ModemManager 的 D-Bus 索引跟着变
	# （Modem/0 -> Modem/1）。device 写死的话 ifup 会一直报 "No device specified"，
	# 表现为「模组明明在、就是没 IP」。这里每轮对齐一次索引。
	_dev=$(uci -q get "network.$SECTION.device")
	if [ "$_dev" != "$_m" ]; then
		log "modem index changed (${_dev:-none} -> $_m), updating network.$SECTION.device"
		uci -q set "network.$SECTION.device=$_m"
		uci -q commit network
		ifdown "$SECTION" >/dev/null 2>&1
		sleep 1
		ifup "$SECTION" >/dev/null 2>&1
	fi

	# 已经拿到 IPv4 就没事
	if ip -4 addr show wwan0 2>/dev/null | grep -q 'inet '; then
		rm -f "$NOIPF"
		return 0
	fi

	# 还没 attach 就别拨，拨了也拿不到 IP
	[ "$(modem_attached "$_m")" = "attached" ] || return 0

	# 计数，避免每 30s 疯狂 ifup
	_n=0
	[ -f "$NOIPF" ] && _n=$(cat "$NOIPF" 2>/dev/null)
	case "$_n" in ''|*[!0-9]*) _n=0 ;; esac
	_n=$((_n + 1))
	echo "$_n" > "$NOIPF"
	# 第 1 轮立刻拨，之后每 4 轮（约 2 分钟）重拨一次
	[ "$_n" -gt 1 ] && [ $((_n % 4)) -ne 1 ] && return 0

	# 配置可能被别的 uci-defaults 改回 disabled=1
	if [ "$(uci -q get network.$SECTION.disabled)" = "1" ]; then
		log "network.$SECTION is disabled, clearing it"
		uci -q set network.$SECTION.disabled='0'
		uci -q set network.$SECTION.autoconnect='1'
		uci -q commit network
	fi

	log "modem $_m attached but wwan0 has no IPv4, bringing up network.$SECTION"
	_out=$(ifup "$SECTION" 2>&1)
	[ -n "$_out" ] && log "  $_out"
	return 0
}

# 连通性探测：任一个公共 DNS 能 ping 通就算在线
check_online() {
	for _t in $PING_TARGETS; do
		ping -c 1 -W 3 "$_t" >/dev/null 2>&1 && return 0
	done
	return 1
}

# 联网兜底：有 IP 不代表真的能上网（bearer 僵死、上游掉线、APN 变了都这样）。
# 每轮做一次真实探测，连续 3 轮（约 90s）不通就重拨一次。
# 这里故意不做 mmcli --reset：实测反复 reset 活着的 modem 会把它搞成
# 「enabled 但 detached」的死状态，只能重启才能恢复，风险大于收益。
ensure_online() {
	# 没有 IPv4 时由 ensure_data 负责，这里不重复处理
	ip -4 addr show wwan0 2>/dev/null | grep -q 'inet ' || return 0

	if check_online; then
		if [ -f "$OFFLINEF" ]; then
			log "internet is back"
			rm -f "$OFFLINEF"
		fi
		return 0
	fi

	_n=0
	[ -f "$OFFLINEF" ] && _n=$(cat "$OFFLINEF" 2>/dev/null)
	case "$_n" in ''|*[!0-9]*) _n=0 ;; esac
	_n=$((_n + 1))

	if [ "$_n" -ge 3 ]; then
		log "no internet for $((_n * WATCH_INTERVAL))s despite IPv4, redialing network.$SECTION"
		echo 0 > "$OFFLINEF"
		ifdown "$SECTION" 2>/dev/null
		sleep 2
		ifup "$SECTION" 2>/dev/null
		return 0
	fi

	echo "$_n" > "$OFFLINEF"
	log "connectivity check failed ($_n/3)"
	return 0
}

configure_apn_once() {
	# 同一轮开机只配置一次
	[ -f "$DONEFILE" ] && return 0
	_m="$1"
	_sim_path=$(mmcli -m "$_m" -K 2>/dev/null | sed -n 's/^modem\.generic\.sim *: *//p' | head -1)
	if [ -z "$_sim_path" ] || [ "$_sim_path" = "--" ]; then
		log "no sim yet, skip apn"
		return 0
	fi

	_sim_id=$(echo "$_sim_path" | sed 's#.*/SIM/##')
	if [ -z "$_sim_id" ]; then
		log "no sim id, skip apn"
		return 0
	fi

	_imsi=""
	_i=0
	while [ -z "$_imsi" ] && [ "$_i" -lt 20 ]; do
		_imsi=$(mmcli -i "$_sim_id" -K 2>/dev/null | sed -n 's/^sim\.properties\.imsi *: *//p' | head -1)
		if [ -z "$_imsi" ] || [ "$_imsi" = "--" ]; then
			_imsi=""
			sleep 3
		fi
		_i=$((_i + 1))
	done
	if [ -z "$_imsi" ]; then
		log "no imsi, skip apn"
		return 0
	fi

	_code=$(echo "$_imsi" | cut -c1-5)
	log "IMSI=$_imsi CODE=$_code"

	case $_code in
		46000|46002|46004|46007|46008) _apn=cmnet;  _auth="none"; _user="";                 _pass="" ;;
		46001|46006|46009)             _apn=wonet;  _auth="none"; _user="";                 _pass="" ;;
		46003|46011|46012)             _apn=ctnet;  _auth="both"; _user="ctnet@mycdma.cn"; _pass="vnet.mobi" ;;
		46015|46022|46123)             _apn=cbnet;  _auth="none"; _user="";                 _pass="" ;;
		*)
			_apn=$(mmcli -m "$_m" -K 2>/dev/null | sed -n 's/^modem\.3gpp\.eps\.initial-bearer\.settings\.apn *: *//p' | head -1)
			if [ -z "$_apn" ] || [ "$_apn" = "--" ]; then
				_apn=cmnet
			fi
			_auth="none"; _user=""; _pass=""
			;;
	esac

	log "APN=$_apn"

	_old=$(uci -q get network.$SECTION.apn)

	uci set network.$SECTION.apn="$_apn"
	uci set network.$SECTION.username="$_user"
	uci set network.$SECTION.password="$_pass"
	uci set network.$SECTION.auth="$_auth"
	uci commit network

	# APN 变了才需要重拨；没变就别折腾正在工作的连接
	if [ "$_old" != "$_apn" ]; then
		log "apn changed (${_old:-none} -> $_apn), redialing network.$SECTION"
		ifdown "$SECTION" 2>/dev/null
		sleep 2
		ifup "$SECTION" 2>/dev/null
	fi

	touch "$DONEFILE"
	return 0
}

echo $$ > "$PIDFILE"
log "worker started (pid $$), waiting up to $((WAIT_TRIES * WAIT_INTERVAL))s for modem"

_m=$(wait_modem)
if [ -z "$_m" ]; then
	log "no modem after $((WAIT_TRIES * WAIT_INTERVAL))s, entering watch-only mode"
else
	log "modem $_m appeared"
	ensure_enabled "$_m"
	configure_apn_once "$_m"
	ensure_data "$_m"
	ensure_online
fi

# 常驻看护
while true; do
	_m=$(modem_index)
	if [ -n "$_m" ]; then
		ensure_enabled "$_m"
		configure_apn_once "$_m"
		ensure_data "$_m"
		ensure_online
	fi
	sleep "$WATCH_INTERVAL"
done
