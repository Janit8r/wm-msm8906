#!/bin/sh
#
# zz-modem-data —— 修「modem 注册成功但没有 IP / 不能上网」
#
# 现象：
#   mmcli 里 state=registered、packet service=attached、operator 也正常，
#   但 wwan0 只有 link-local IPv6，没有 IPv4、没有默认路由，整机不能上网。
#
# 根因：
#   /rom/etc/uci-defaults/99-simadmin 把 network.modem 设成 disabled=1
#   （simadmin 想让 netifd 别碰 modem，它自己用 QMI/VoLTE 管 IMS bearer）。
#   随后的 openstick_tweak 只补了 autoconnect=1 / auto=1，没有清 disabled，
#   于是 netifd 永远不启用这个接口：
#     - ifstatus modem -> "Interface modem not found"
#     - mmcli 里没有 default bearer，只有 initial bearer
#     - 没人把 bearer 的 IP/网关写到 wwan0 上
#
# 实测：
#   清掉 disabled、让 netifd 的 modemmanager proto 接管后，IP、默认路由、
#   MTU(1432)、DNS 全部由 netifd 自动配好，firewall 的 wan zone（含 wwan0
#   与 network 'modem'，masq=1）也是现成的，LAN 侧直接能上网。
#
# 命名：
#   用 zz- 前缀保证在 openstick_tweak（字母序 o < z）之后执行，
#   否则会被 openstick_tweak 的 uci 操作顺序覆盖。

uci -q set network.modem.disabled='0'
uci -q set network.modem.autoconnect='1'
uci -q set network.modem.auto='1'
uci -q commit network

exit 0
