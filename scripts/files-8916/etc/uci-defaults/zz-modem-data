#!/bin/sh
#
# zz-modem-data —— 建立 netifd 的 modem 接口（本固件数据连接的唯一入口）
#
# 为什么必须有这个文件：
#   本固件把数据连接完全交给 netifd 的 modemmanager proto：由它调
#   mmcli --simple-connect 建 bearer，并把 IPv4 / 默认路由 / MTU / DNS
#   写到 wwan0 上。没有 interface 段 netifd 就不会去拨号，表现是
#   「modem registered + packet-service attached，但 wwan0 没有 IPv4、
#   整机不能上网」。
#
#   容易踩的坑：段不存在时 `uci set network.modem.apn=3gnet` 会建出一个
#   `config modem 'modem'`（类型等于段名），netifd 不认这种段，
#   看起来配置写进去了、实际上永远不生效。所以这里显式写 `=interface`。
#
#   /etc/init.d/auto_apn 的 worker 只负责按 IMSI 改 APN 选项再 ifup，
#   不负责建段 —— 段必须在这里建好。
#
# 命名用 zz- 前缀，保证在 openstick_tweak 之后执行。

uci -q batch <<-EOF
	set network.modem=interface
	set network.modem.proto='modemmanager'
	set network.modem.device='0'
	set network.modem.iptype='ipv4'
	set network.modem.metric='10'
	set network.modem.peerdns='1'
	set network.modem.disabled='0'
	set network.modem.autoconnect='1'
	commit network
EOF

# 官方 simadmin 包留下的三个旧脚本会自启：simadmin-data 用裸 QMI WDS 抢数据面
# （本模组实测会被写进崩溃循环），simadmin-imsd / simadmin-watchdog 会 rebind
# 模组驱动。短信收发只依赖 /etc/init.d/simadmin，这三个一律关掉。
for s in simadmin-data simadmin-imsd simadmin-watchdog; do
	[ -x "/etc/init.d/$s" ] && "/etc/init.d/$s" disable 2>/dev/null
	[ -x "/etc/init.d/$s" ] && "/etc/init.d/$s" stop 2>/dev/null
done

# qmi_auto_activate 常驻一个 `qmicli -d /dev/wwan0qmi0 --uim-monitor-refresh-all`，
# 长期独占 QMI 通道，和 ModemManager 抢端口。实测开机阶段会把 MSS 固件打进
# "Watchdog detects stalled initialization" 崩溃循环（一次开机崩 9 次，每 ~41s 一次），
# 崩溃后 ModemManager 的 D-Bus 索引还会从 Modem/0 变成 Modem/1。
# MM 1.24 自带 SIM 热插拔监控，不需要它。
[ -x /etc/init.d/qmi_auto_activate ] && /etc/init.d/qmi_auto_activate disable 2>/dev/null
[ -x /etc/init.d/qmi_auto_activate ] && /etc/init.d/qmi_auto_activate stop 2>/dev/null

# ModemManager 出厂是 DEBUG 级日志 + 落盘 /var/log/mm.log，每条 QMI 交互都写一次，
# msm8916 上这部分开销不可忽略，改回 INFO。
sed -i 's/^LOG_LEVEL="DEBUG"/LOG_LEVEL="INFO"/' /etc/init.d/modemmanager 2>/dev/null

exit 0
