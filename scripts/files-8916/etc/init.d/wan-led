#!/bin/sh /etc/rc.common
#
# wan-led —— 上网状态指示灯服务
#   由 /usr/bin/wan-led-worker 常驻探测连通性，联网成功亮绿灯、断网亮红灯。
#   详见 /usr/bin/wan-led-worker 顶部注释。
#
START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/wan-led-worker
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
