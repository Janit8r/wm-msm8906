#!/bin/sh /etc/rc.common
#
# wifi-watchdog —— wcn36xx 固件挂死自愈服务
#   由 /usr/bin/wifi-watchdog 常驻巡检，检测到挂死特征就复位 WCNSS。
#   详见 /usr/bin/wifi-watchdog 顶部注释。
#
START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/wifi-watchdog
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
