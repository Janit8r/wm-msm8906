#!/bin/sh /etc/rc.common
#
# auto_apn —— 由 procd 托管 /usr/bin/auto_apn-worker
#
# 背景（务必保留这些行为，否则 simadmin / 拨号会失效）：
#
#  1) 本机的 modem 由 remoteproc(qcom-q6v5-mss) 拉起，实测上电后约 3 分钟才出现。
#     原实现只等 30 x 2s = 60s，等不到就 `logger "no modem"` 退出，
#     于是 mmcli --enable 永远不执行，modem 一直停在 disabled 状态。
#     这会让 simadmin 的 /api/cells 直接报：
#       org.freedesktop.ModemManager1.Error.Core.WrongState:
#       Wrong state: modem in disabled state
#
#  2) ModemManager 1.24 的这个构建里没有 --no-auto-enable，但实测也不会自动启用
#     modem（重启 MM 后 modem 依旧回到 disabled），所以必须由 worker 显式启用。
#
#  3) rc.common 的 start() 是同步执行的，S99 阶段如果在这里长时间阻塞会拖住开机。
#     所以真正的等待/轮询全部放在 worker 里，由 procd 在后台托管，start 立即返回。
#
#  4) 早期版本在 start() 里用 `worker &` 起后台进程，实测这个子进程会被回收
#     （ps 里查不到，pidfile 里的 pid 是死的），modem 一旦回到 disabled 就再也没人管。
#     改用 procd 托管后，worker 常驻且意外退出会被自动拉起。
#
#  5) MM 重启、modem 复位、remoteproc rebind 之后 modem 会重新变回 disabled，
#     所以 worker 配置完 APN 后不退出，转入看护循环持续把它拉回 enabled。

START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/auto_apn-worker

start_service() {
	procd_open_instance auto_apn
	procd_set_param command "$PROG"
	# respawn <阈值秒> <超时秒> <重试次数>：1 小时内崩溃 5 次以内都会自动拉起
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# worker 的 pidfile 由它自己维护，procd 停实例时进程已被终止，
	# 这里只清掉残留状态文件，避免下次开机误判“APN 已配置过”。
	rm -f /var/run/auto_apn.pid
	return 0
}
