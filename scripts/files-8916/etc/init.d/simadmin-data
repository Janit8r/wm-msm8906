#!/bin/sh /etc/rc.common
#
# 覆盖 simadmin 软件包自带的 /etc/init.d/simadmin-data（files/ 目录会覆盖包文件）。
#
# 为什么要有这个覆盖：
#   /usr/bin/simadmin-data 里 `WAIT_IMS=${WAIT_IMS:-600}`，即"等 VoLTE/IMS 注册
#   最多 10 分钟，等不到才拉起数据连接"。而这张卡 IMS 注册是失败的
#   （logread 里 volte_register_initial_unexpected_status:420），
#   于是开机后前 10 分钟一直不拨数据：
#     mmcli 里 state=registered / access-tech=lte / signal 正常，
#     但 wwan0 没有 IPv4、没有默认路由 —— 表现为「SIM 注册成功却上不了网」。
#   实测设备开机 8 分 33 秒时 LuCI 里完全没有网络，数据连接要到开机满 10 分钟
#   （17:00:24，正好 600s）才被拉起来。
#
# 这张卡是纯数据上网卡，不打电话，IMS/VoLTE 对上网没有意义。
# 所以这里把 WAIT_IMS 压到 30 秒：给 IMS 留 30 秒注册窗口，等不到就直接拨数据，
# 开机 30 秒内即可上网，而不是干等 10 分钟。
#
# 用 env 注入而不是去改 /usr/bin/simadmin-data：不改软件包逻辑，只改它的默认值，
# 软件包升级时也不会和我们的改动冲突。

START=95
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/simadmin-data
	procd_set_param env WAIT_IMS=30
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
