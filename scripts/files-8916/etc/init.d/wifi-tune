#!/bin/sh /etc/rc.common
#
# wifi-tune —— 开机把无线调到「国家码 CN / 功率最大 / 干净信道 / 关省电」
#
# 具体参数和原因见 /usr/bin/wifi-tune-worker 的注释。
# 这里只负责用 procd 托管 worker：rc.common 的 start() 是同步的，
# 在 S99 里长时间等待会拖住开机；而后台子进程又会被回收，
# 所以交给 procd 最稳（和 auto_apn 的做法一致）。

USE_PROCD=1
START=99
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/wifi-tune-worker
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

stop_service() {
	return 0
}
